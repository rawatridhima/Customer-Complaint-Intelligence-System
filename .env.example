# Copy to .env and fill in. Never commit .env
#
# Development (docker-compose.yml) works with these values as they are.
# Production (docker-compose.prod.yml) also needs ENVIRONMENT, POSTGRES_PASSWORD,
# a real JWT_SECRET and SITE_ADDRESS; see docs/DEPLOYMENT.md.

# development | production. Production refuses to start with placeholder secrets.
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://cis:cis_password@db:5432/cis
REDIS_URL=redis://redis:6379/0

# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# Production only. The database password (letters, digits, - and _ only).
# Generate it, like JWT_SECRET, with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
# Production only. ":80" for plain HTTP (laptop, or a server by IP address);
# a domain name such as complaints.example.com for automatic HTTPS.
SITE_ADDRESS=:80

MODEL_DIR=/models
CONFIDENCE_THRESHOLD=0.95

# LLM stage (summary, suggested resolution, draft response).
# Leave LLM_PROVIDER blank to run without one: complaints get a template
# response and are flagged for manual handling.
#
#   Claude:  LLM_PROVIDER=anthropic  LLM_MODEL=claude-haiku-4-5
#   Gemini:  LLM_PROVIDER=openai     LLM_MODEL=<a Gemini model id>
#            LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Groq:    LLM_PROVIDER=openai     LLM_MODEL=<a Groq model id>
#            LLM_BASE_URL=https://api.groq.com/openai/v1
#   Ollama:  LLM_PROVIDER=openai     LLM_MODEL=llama3.2  LLM_API_KEY=ollama
#            LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
PROMPT_VERSION=v2
# Complaints sent to the LLM per minute (2 requests each). Keeps a batch of
# complaints inside free-tier rate limits instead of failing with HTTP 429.
LLM_RATE_LIMIT=5/m

PRIORITY_W_SENTIMENT=0.40
PRIORITY_W_CATEGORY=0.25
PRIORITY_W_URGENCY=0.20
PRIORITY_W_REPEAT=0.15
