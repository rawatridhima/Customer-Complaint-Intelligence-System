# Copy to .env and fill in. Never commit .env

DATABASE_URL=postgresql+psycopg://cis:cis_password@db:5432/cis
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

MODEL_DIR=/models
CONFIDENCE_THRESHOLD=0.75

# Leave blank for now. The LLM stage is stubbed in this skeleton.
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
PROMPT_VERSION=v1

PRIORITY_W_SENTIMENT=0.40
PRIORITY_W_CATEGORY=0.25
PRIORITY_W_URGENCY=0.20
PRIORITY_W_REPEAT=0.15
